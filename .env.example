# Copy this file to .env and add your API keys.

# Required for Market Stress page — get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Required for Wheel Screener, Market Monitor, Momentum Screener (real-time overlay), and Breadth
# Get a key at: https://massive.com — Stocks Starter plan or higher
MASSIVE_API_KEY=your_massive_key_here

# Optional — enables AI analysis and next-day direction indicator (Claude Opus)
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
